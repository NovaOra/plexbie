# Plexbie configuration.
#
#   cp config/.env.example config/.env
#
# Only the four variables under REQUIRED are needed to start. Everything else is
# optional: a plugin that needs a missing setting logs a warning and stands down
# rather than failing.
#
# Numeric settings that cannot be parsed are logged and ignored, not fatal:
#   Ignoring invalid integer for BOT_OWNER_ID: 'novaora' - this setting is now INACTIVE.
#
# Never commit config/.env - it is gitignored.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

DISCORD_BOT_TOKEN=
# Needs the Server Members privileged intent.

GUILD_ID=
# Your household's Discord server ID (Developer Mode on, right-click the server, Copy Server ID).
# Required: commands and admin buttons work only in this server, and commands are only ever
# added there. The setup page fills it in. Left blank, Plexbie picks the server only when it
# can prove it's yours (your channel/role settings are there, or it's the only server and the
# bot's owner owns it) and saves it here; otherwise commands and admin buttons stay off.
# Also turn off Public Bot (Developer Portal: Installation > Install Link: None, then Bot > Public Bot).

PLEX_URL=http://localhost:32400
PLEX_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# ADMINISTRATION
# ─────────────────────────────────────────────────────────────────────────────
# Any one of these grants admin: the Discord `administrator` permission, the
# ADMIN_ROLE_ID role, or BOT_OWNER_ID. The first two count only in the GUILD_ID server;
# BOT_OWNER_ID counts everywhere.

BOT_OWNER_ID=
ADMIN_ROLE_ID=
ADMIN_CHANNEL_ID=
# Where access requests land and where health alerts are sent.

# Inviting, removing and listing who the server is shared with happen on plex.tv
# as the owner. PLEX_TOKEN from "Sign in with Plex" does all of that; these are
# only a fallback when the token can't (a token copied from a server, say).
PLEX_USERNAME=
PLEX_PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# CHANNELS AND ROLES
# ─────────────────────────────────────────────────────────────────────────────

UPDATES_CHANNEL_ID=
# New media announcements.

ARRIVALS_ROLE_ID=
# Optional: mentioned on each new announcement (never on edits). Members join or
# leave it with the "Ping me for new arrivals" button in the announcements channel.

PLEX_MEMBER_ROLE_ID=
# Granted when a Plex invite is accepted.




# ─────────────────────────────────────────────────────────────────────────────
# STATS DISPLAYS  (watch_tracking)
# ─────────────────────────────────────────────────────────────────────────────
# The three messages must already exist. Post a placeholder in the channel and
# put its ID here. The bot only edits them, never creates them, so a wrong ID
# cannot litter the channel.

STATS_CHANNEL_ID=
NOW_WATCHING_MESSAGE_ID=
LEADERBOARD_MESSAGE_ID=
WATCH_STREAK_MESSAGE_ID=


# ─────────────────────────────────────────────────────────────────────────────
# INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────
# Tautulli drives the leaderboard and the inactivity check. TMDB adds artwork and
# summaries to announcements, and /request needs it to search films and TV.
# Seerr takes requests; Sonarr and Radarr show download progress; SABnzbd shows
# live percentages and downloads books.

TAUTULLI_URL=
TAUTULLI_TOKEN=

TMDB_API_KEY=

SEERR_URL=
SEERR_TOKEN=

SONARR_URL=
SONARR_TOKEN=
RADARR_URL=
RADARR_TOKEN=

SABNZBD_URL=
SABNZBD_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# BOOK DOWNLOADS
# ─────────────────────────────────────────────────────────────────────────────
# Audiobook and ebook requests: Plexbie searches your indexers through NZBHydra
# and hands the best result to SABnzbd. Leave empty if you don't take book requests.

NZBHYDRA_URL=
NZBHYDRA_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# WEBHOOK LISTENER
# ─────────────────────────────────────────────────────────────────────────────

WEBHOOK_PORT=7980
WEBHOOK_BIND=127.0.0.1
# Loopback by default. A /webhook/* route whose secret is unset refuses every
# request, so Plexbie makes any missing secret below on start (and saves it here);
# the setup page's Connect hands them to Seerr and Tautulli.
# Webhooks are plain HTTP: when this listens beyond loopback, keep the port on a
# network you trust (home LAN, Tailscale), or behind a TLS reverse proxy whose
# https:// address keeps the /webhook/seerr or /webhook/tautulli path.

# How each service presents its secret differs by what it can send:
#   Sonarr / Radarr  X-Api-Key header, equal to the secret
#   Tautulli         Authorization: Bearer <secret>, or ?secret=<secret> (logged
#                    as a warning once a run: URLs end up in proxy and access logs)
#   Plex             ?token=<secret> appended to the webhook URL (Plex sends no auth)
#   Seerr        Authorization header
SONARR_WEBHOOK_SECRET=
RADARR_WEBHOOK_SECRET=
TAUTULLI_WEBHOOK_SECRET=
SEERR_WEBHOOK_SECRET=
PLEX_WEBHOOK_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# BEHAVIOUR
# ─────────────────────────────────────────────────────────────────────────────

INACTIVITY_WARNING_DAYS=25
INACTIVITY_REMOVAL_DAYS=30
# A warning is always delivered a full pass before any removal. People who have
# never watched anything count too, from when Plexbie started tracking them (see
# README, Plex access). The daily check
# warns and removes nobody (and tells the admins) when Tautulli hasn't recorded a
# play by anyone for over 7 days, and removes nobody when one pass would remove
# more than 3 people or a quarter of everyone tracked, whichever is more.

HEALTH_CHECK_INTERVAL=300
HEALTH_MAX_FAILURES=3
HEALTH_ALERT_COOLDOWN=1800

WATCH_PARTY_CHANNEL_ID=
WATCH_PARTY_CREDIT_INTERVAL=300


# ─────────────────────────────────────────────────────────────────────────────
# BOOKSHELF PROCESSOR
# ─────────────────────────────────────────────────────────────────────────────
# Container paths. Mount your download and library directories onto these.

BOOKSHELF_AUDIOBOOK_WATCH=/watch/audiobooks
BOOKSHELF_EBOOK_WATCH=/watch/ebooks
BOOKSHELF_AUDIOBOOK_LIBRARY=/library/audiobooks
BOOKSHELF_EBOOK_LIBRARY=/library/ebooks
# The library folders must exist (be mapped) and be full paths; Plexbie never
# creates them and holds finished downloads until they are there. A blank value
# counts as missing.

BOOKSHELF_SETTLE_SECONDS=120
# How long an item must stop changing before it is treated as a finished download.

BOOKSHELF_CACHE_DIR=/app/cache/bookshelf
# Where downloaded cover art is cached.


# ─────────────────────────────────────────────────────────────────────────────
# STORAGE AND LOGGING
# ─────────────────────────────────────────────────────────────────────────────

DB_URL=sqlite:///config/plexbie.db
# Keep this off any file-syncing tool: syncing a live SQLite file can corrupt it.

LOG_LEVEL=INFO
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=5


# --- Website --------------------------------------------------------------
# The bot serves its own website (members' area, requests, Manage) from the same
# container. It's on by default at http://<this host>:7979; WEB_PORT=0 turns it off.
WEB_PORT=7979
WEB_BIND=0.0.0.0
# The address people reach it at. The usual one is plexbie.<your domain>, e.g.
# https://plexbie.example.com, pointed at this container by your tunnel or proxy
# (the setup page suggests it and checks it reaches this Plexbie). Leave empty and
# the site works it out from each request (proxies: X-Forwarded-Proto/Host). Set it
# once the site is public so links in invites and sign-in always use the real name.
# The household's Plexbie is at the root of this address.
WEB_PUBLIC_URL=
# Moved Plexbie to a new address? List the old ones here (comma-separated), and
# phones signed in through them keep working while the app moves to the new one.
WEB_ALIASES=
# Who runs this Plexbie, for the website's Privacy and Terms pages: your name or
# your household's, and an email address people can write to. Both optional; the
# pages say "its owner" and "an admin in the Discord server" without them.
SITE_OPERATOR=
SITE_CONTACT=
# Alerts in the Plexbie phone app. They go through the Plexbie project's own Expo
# account (the app is built against it), so only the project's own install can send
# them: APP_PUSH=expo with that account's EXPO_ACCESS_TOKEN, and Expo's "enhanced push
# security" on (without it, Expo takes app alerts from any sender, token or not).
# Leave both empty: members use the website's alerts, which this install
# sends itself and which work on any phone, including from Safari on a Home Screen.
# APP_PUSH=expo without the token sends nothing and says so in the log at start-up.
APP_PUSH=
EXPO_ACCESS_TOKEN=
WEB_DIST=web/dist
# Posters and covers are kept here (inside config/, so not on the container's own
# disk), up to WEB_IMAGE_CACHE_MB; past that the least recently used go.
WEB_IMAGE_CACHE=config/cache/web-images
WEB_IMAGE_CACHE_MB=500
# Proxies allowed to say who a visitor is (X-Forwarded-For/-Proto/-Host), as
# addresses or ranges, comma-separated (names don't work). Empty means this
# machine and Docker's networks (127.0.0.0/8, ::1, 172.16.0.0/12), where
# cloudflared and Nginx Proxy Manager usually run; if your home network itself
# uses 172.16-31.x, it's left out. Other LAN machines are never trusted, and the
# log says so if a proxy that isn't listed forwards visitors. Behind such a proxy,
# set WEB_PUBLIC_URL too: without it the site can't tell visitors came over https,
# so sign-in cookies go out without Secure and no HSTS is sent (Manage > Health
# lists the proxy until WEB_PUBLIC_URL is set).
TRUSTED_PROXIES=
# Signs login cookies. Leave empty and one is made on first start and kept in
# config/.web_session_secret; set your own with e.g. `openssl rand -hex 32`.
# Changing it signs everyone out of the website (not the phone app); Manage >
# Health > Sign out every other session ends both without a restart.
WEB_SESSION_SECRET=
# "Log in with Discord" (optional; "Sign in with Plex" needs nothing). From the
# Discord developer portal's OAuth2 page. Under OAuth2 > Redirects, Discord must list
# <WEB_PUBLIC_URL>/auth/discord/callback exactly (Manage > Health checks it). With
# WEB_PUBLIC_URL set, Plexbie always uses that address and DISCORD_CALLBACK_URL is
# ignored; set it only for a site without a public address.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=

# Email to members who joined without Discord (inactivity warnings, request news),
# used when they haven't turned on phone alerts on the website. Off unless set.
# Proton Mail: smtp.protonmail.ch, port 587, username = the address, password = an SMTP token.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Empty means "Plexbie <SMTP_USERNAME>". Most mail services only send from an
# address you own, so keep it on your own domain.
