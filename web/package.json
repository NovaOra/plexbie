{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "build:preview": "VITE_SAMPLE=1 vite build --outDir dist-preview --emptyOutDir",
    "build:demo": "VITE_SAMPLE=1 VITE_DEMO=1 vite build --outDir dist-demo --emptyOutDir && printf '/*\\n  X-Robots-Tag: noindex\\n' > dist-demo/_headers",
    "build:project": "tsc -b && vite build --config vite.project.config.ts",
    "dev:project": "vite --config vite.project.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
