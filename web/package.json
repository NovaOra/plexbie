  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
